# Frontend public environment (never put secrets in VITE_* variables)
# Leave empty for local development, where Vite proxies /api to the backend.
# For production, use the backend origin, for example: https://api.example.com
VITE_API_BASE_URL=

# Optional: local Vite dev proxy target. Defaults to http://localhost:3001.
# VITE_API_PROXY_TARGET=http://localhost:3001
